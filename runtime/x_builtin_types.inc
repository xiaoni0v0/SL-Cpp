// 内置类型清单。
// X(枚举名, 访问器名, SL 层类名, 基类枚举名/填 NoBase 表示没有基类)
X(Object, type_object, "object", NoBase)
X(Type, type_type, "type", Object)
X(NoneType, type_none_type, "NoneType", Object)
X(SingletonType, type_singleton_type, "SingletonType", Object)
X(Number, type_number, "numbers.Number", Object)
X(Real, type_real, "numbers.Real", Number)
X(Int, type_int, "int", Real)
X(Decimal, type_decimal, "decimal", Real)
X(Bool, type_bool, "bool", Real)
X(Str, type_str, "str", Object)
X(Tuple, type_tuple, "tuple", Object)

// 异常类型清单
X(BaseException, type_base_exception, "BaseException", Object)
X(SystemExit, type_system_exit, "SystemExit", BaseException)
X(KeyboardInterrupt, type_keyboard_interrupt, "KeyboardInterrupt", BaseException)
X(Exception, type_exception, "Exception", BaseException)
X(SyntaxError, type_syntax_error, "SyntaxError", Exception)
X(TypeError, type_type_error, "TypeError", Exception)
X(ValueError, type_value_error, "ValueError", Exception)
X(NameError, type_name_error, "NameError", Exception)
X(AttributeError, type_attribute_error, "AttributeError", Exception)
X(IndexError, type_index_error, "IndexError", Exception)
X(MathError, type_math_error, "MathError", Exception)
X(DecimalException, type_decimal_exception, "decimal.DecimalException", MathError)
X(DispatchError, type_dispatch_error, "DispatchError", Exception)
X(RecursionError, type_recursion_error, "RecursionError", Exception)
X(MemoryError, type_memory_error, "MemoryError", Exception)
X(IOError, type_io_error, "IOError", Exception)
X(ImportError, type_import_error, "ImportError", Exception)
