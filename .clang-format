# Generated by CLion for K&R braces
# The K&R style, also known as Kernighan and Ritchie style, is a common coding style named after the authors of "The C Programming Language."
# In this style, the opening brace is placed on the same line as the control statement, and the closing brace is on its own line.
BasedOnStyle: LLVM

BraceWrapping:
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
BreakBeforeBraces: Custom

IndentWidth: 4
AllowShortIfStatementsOnASingleLine: true
AllowShortLoopsOnASingleLine: true
InsertNewlineAtEOF: true
SpaceAfterCStyleCast: true
ColumnLimit: 100

AlignAfterOpenBracket: true
BinPackArguments: false
BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: true
BreakAfterOpenBracketBracedList: true
BreakBeforeCloseBracketBracedList: true

LineEnding: LF

# 头文件分四组，组内连续排、组间空一行：
#   1. 这个 .cpp 自己对应的头（clang-format 按文件名自动识别，优先级 0）
#   2. 项目里的其他头
#   3. C / C++ 标准头
#   4. 第三方库的头
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 2
  - Regex: '^<[a-z0-9_]+(\.h)?>$'
    Priority: 3
  - Regex: "^<"
    Priority: 4
